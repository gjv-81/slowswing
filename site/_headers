# Cloudflare static-assets headers. The page and the public feed must never be
# served from a stale browser cache: every deploy should be visible on the next
# navigation, not after a hard refresh. (Hashed assets, if any are ever added,
# can be cached long — these three change in place.)
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/teaser.json
  Cache-Control: no-cache
/posts.js
  Cache-Control: no-cache
/version.json
  Cache-Control: no-cache
/stats_history.json
  Cache-Control: no-cache
